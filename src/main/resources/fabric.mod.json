{
	"schemaVersion": 1,
	"id": "horseloyalty",
	"version": "${version}",
	"name": "Horse Loyalty",
	"description": "Horses bond with their riders: loyalty levels, gaits, boat-style steering, hunger, foals, personalities and genetics.",
	"authors": [
		"XZiggsX"
	],
	"license": "MIT",
	"icon": "assets/horseloyalty/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.xziggsx.horseloyalty.HorseLoyaltyMod"
		],
		"client": [
			"com.xziggsx.horseloyalty.client.HorseLoyaltyClient"
		]
	},
	"mixins": [
		"horseloyalty.core.mixins.json",
		"horseloyalty.riding.mixins.json",
		"horseloyalty.personality.mixins.json",
		"horseloyalty.genetics.mixins.json",
		"horseloyalty.foals.mixins.json",
		"horseloyalty.summoning.mixins.json",
		"horseloyalty.feedback.mixins.json",
		{
			"config": "horseloyalty.riding.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "horseloyalty.loyalty.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "horseloyalty.horseinfo.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "horseloyalty.dev.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
